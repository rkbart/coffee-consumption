{
  "name": "brew-variance",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Cafe inventory variance tracker — recipe-based theoretical usage vs actual counts.",
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"node --watch server/index.js\" \"vite\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
